# Names only. Copy to .env for local overrides. Never commit .env.
# Render sets PORT itself. Leave these blank unless you mean to override them.

PORT=
HOST=
DATA_DIR=

# Set both, or neither. Both are required on Render so the wish list survives
# spin-down. Leave both unset locally to use a JSON file in DATA_DIR.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
